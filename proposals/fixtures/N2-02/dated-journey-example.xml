<?xml version="1.0" encoding="UTF-8"?>
<PublicationDelivery xmlns="http://www.netex.org.uk/netex" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.netex.org.uk/netex NeTEx_publication.xsd" version="1.0">
    <PublicationTimestamp>2026-11-02T12:00:00</PublicationTimestamp>
    <ParticipantRef>ENT</ParticipantRef>
    <dataObjects>
        <CompositeFrame id="ENT:CompositeFrame:DatedJourneyExample" version="1">
            <codespaces>
                <Codespace id="ent">
                    <Xmlns>ENT</Xmlns>
                    <XmlnsUrl>https://registry.example.org/netex</XmlnsUrl>
                </Codespace>
            </codespaces>
            <frames>
                <ServiceCalendarFrame id="ENT:ServiceCalendarFrame:DatedJourneyExample" version="1">
                    <operatingDays>
                        <OperatingDay id="ENT:OperatingDay:2026-12-14" version="1">
                            <CalendarDate>2026-12-14</CalendarDate>
                        </OperatingDay>
                    </operatingDays>
                </ServiceCalendarFrame>
                <TimetableFrame id="ENT:TimetableFrame:DatedJourneyExample" version="1">
                    <vehicleJourneys>
                        <!-- Planned passenger journeys. No dayTypes: the operating days come from the dated journeys. -->
                        <ServiceJourney id="ENT:ServiceJourney:R10-1001" version="1">
                            <Name>Oslo S - Lillehammer</Name>
                        </ServiceJourney>
                        <ServiceJourney id="ENT:ServiceJourney:R10-1001-Bus" version="1">
                            <Name>Oslo S - Lillehammer (rail replacement bus)</Name>
                        </ServiceJourney>

                        <!-- Option A: DatedServiceJourney -->
                        <!-- The train on 14 December is replaced. -->
                        <DatedServiceJourney id="ENT:DatedServiceJourney:R10-1001-2026-12-14" version="1">
                            <ServiceAlteration>replaced</ServiceAlteration>
                            <ServiceJourneyRef ref="ENT:ServiceJourney:R10-1001" version="1"/>
                            <OperatingDayRef ref="ENT:OperatingDay:2026-12-14"/>
                        </DatedServiceJourney>
                        <!-- The bus that replaces it. NeTEx 2.0 has no DatedServiceJourneyRef, so DatedVehicleJourneyRef is used. -->
                        <DatedServiceJourney id="ENT:DatedServiceJourney:R10-1001-Bus-2026-12-14" version="1">
                            <ServiceJourneyRef ref="ENT:ServiceJourney:R10-1001-Bus" version="1"/>
                            <replacedJourneys>
                                <DatedVehicleJourneyRef ref="ENT:DatedServiceJourney:R10-1001-2026-12-14" version="1"/>
                            </replacedJourneys>
                            <OperatingDayRef ref="ENT:OperatingDay:2026-12-14"/>
                        </DatedServiceJourney>

                        <!-- Option B: DatedVehicleJourney, same content. The alteration is called ServiceAlterationType and comes last. -->
                        <DatedVehicleJourney id="ENT:DatedVehicleJourney:R10-1001-2026-12-14" version="1">
                            <ServiceJourneyRef ref="ENT:ServiceJourney:R10-1001" version="1"/>
                            <OperatingDayRef ref="ENT:OperatingDay:2026-12-14"/>
                            <ServiceAlterationType>replaced</ServiceAlterationType>
                        </DatedVehicleJourney>
                        <DatedVehicleJourney id="ENT:DatedVehicleJourney:R10-1001-Bus-2026-12-14" version="1">
                            <ServiceJourneyRef ref="ENT:ServiceJourney:R10-1001-Bus" version="1"/>
                            <replacedJourneys>
                                <DatedVehicleJourneyRef ref="ENT:DatedVehicleJourney:R10-1001-2026-12-14" version="1"/>
                            </replacedJourneys>
                            <OperatingDayRef ref="ENT:OperatingDay:2026-12-14"/>
                        </DatedVehicleJourney>
                    </vehicleJourneys>
                </TimetableFrame>
            </frames>
        </CompositeFrame>
    </dataObjects>
</PublicationDelivery>
